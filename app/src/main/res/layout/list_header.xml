<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NATIVE MACRO" android:textColor="@color/accent" android:textSize="11sp" android:letterSpacing="0.18" android:paddingTop="8dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="30sp" android:textStyle="bold" android:textColor="@color/ink" android:paddingTop="4dp" android:paddingBottom="16dp"/>
<LinearLayout android:id="@+id/hero" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/soft" android:padding="18dp">
<dev.local.nativemacrohelper.GifBanner android:id="@+id/banner" android:layout_width="match_parent" android:layout_height="140dp" android:scaleType="fitCenter" android:contentDescription="用户提供的动态插画"/>
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="正在检查原生组件…" android:textColor="@color/muted" android:textSize="12sp" android:paddingTop="8dp"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="16dp">
<Button android:id="@+id/recent" style="@style/QuietButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="最近使用"/>
<Button android:id="@+id/manual" style="@style/QuietButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginHorizontal="8dp" android:text="添加包名"/>
<Button android:id="@+id/diagnostics" style="@style/QuietButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="设置与诊断"/></LinearLayout>
<EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/card" android:paddingHorizontal="16dp" android:singleLine="true" android:inputType="text" android:imeOptions="actionSearch" android:textSize="15sp" android:textColor="@color/ink" android:textColorHint="@color/muted" android:hint="搜索名称或包名" android:importantForAutofill="no"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingTop="8dp"><TextView android:id="@+id/count" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="应用" android:textColor="@color/muted" android:textSize="13sp"/><CheckBox android:id="@+id/favorites" android:layout_width="wrap_content" android:layout_height="48dp" android:text="仅收藏" android:textSize="13sp"/></LinearLayout>
<TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:text="正在读取应用…" android:textColor="@color/muted" android:gravity="center"/>
</LinearLayout>
